---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCalculator from '../components/QuoteCalculator.tsx';
---
<BaseLayout
  title="Get Your Instant Quote | Gal Gone Green"
  description="Eco-friendly cleaning across the Shenandoah Valley. Enter your home details and see your flat-rate price in under 60 seconds."
  canonicalPath="/quote-preview"
  noindex={true}
>
  <div class="min-h-screen py-10 px-4" style="background:#faf8f4">
    <div class="max-w-2xl mx-auto">
      <div class="mb-6 p-3 rounded border border-amber-300 bg-amber-50 text-sm text-amber-900">
        <strong>Preview — internal testing only.</strong> Submit is disabled. Wilkins: please test every scenario you'd normally run through the pricing sheet and note anything that doesn't match.
      </div>
      <h1 class="font-['DM_Serif_Display'] text-3xl md:text-5xl text-[#2c2c2c] mb-3">
        Get your instant quote
      </h1>
      <p class="text-base md:text-lg text-[#555] mb-2">
        Eco-friendly cleaning across the Shenandoah Valley since 2011. Tell us about your home and we'll show you a flat price — no hourly surprises.
      </p>
      <p class="text-sm text-[#777] mb-8">
        15 years in the Valley · Bonded, insured, background-checked · Flat-rate · Eco-friendly products
      </p>
      <QuoteCalculator client:load submitMode="preview" />
    </div>
  </div>
</BaseLayout>
